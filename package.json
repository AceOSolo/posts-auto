{
  "name": "posts-auto",
  "private": true,
  "type": "module",
  "description": "SaaS de posts LinkedIn rédigés par IA, validés par chaque titulaire et publiés automatiquement.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
