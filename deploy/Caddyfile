{$DOMAIN} {
	encode zstd gzip
	# Les en-têtes de sécurité sont posés par l'application (next.config.ts).
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	# Envois de photos : 25 Mo au plus (actions serveur de l'application).
	request_body {
		max_size 26MB
	}
	log {
		output stdout
		format json
	}
}

# L'adresse en www renvoie vers le domaine principal.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
