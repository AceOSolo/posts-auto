# Production : copier en deploy/.env (jamais dans le dépôt) et compléter. Voir docs/deploiement.md.

# --- Serveur ---
DOMAIN=app.exemple.fr
APP_URL=https://app.exemple.fr
# Image publiée par l'intégration continue (ou construite sur le serveur : docker compose build).
IMAGE=ghcr.io/aceosolo/posts-auto:latest

# --- Base de données (conteneur postgres) ---
POSTGRES_USER=rostra
POSTGRES_DB=rostra
# openssl rand -base64 32
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# --- Chiffrement des jetons (SEC-02) : « id:clé_base64 » ---
# Clé : openssl rand -base64 32. À conserver hors du serveur (sans elle, les connexions
# LinkedIn et Canva enregistrées sont perdues). Rotation : ajouter une nouvelle clé, changer l'id.
TOKEN_ENCRYPTION_KEYS=k1:
TOKEN_ENCRYPTION_KEY_ID=k1

# --- LinkedIn (application de l'éditeur) ---
LINKEDIN_MODE=api
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610

# --- IA ---
AI_MODE=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_USD_TO_EUR=0.86
# Images générées : « higgsfield » (clés ci-dessous) ou vide (pas d'image générée).
IMAGE_MODE=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- E-mails (Brevo, domaine authentifié SPF/DKIM/DMARC) ---
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Rostra
SUPPORT_EMAIL=
SALES_EMAIL=

# --- Paiement (Stripe) ---
BILLING_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Connexions facultatives ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=
