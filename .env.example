# Copier en .env et adapter. Valeurs de développement local (compose.yaml).

# Base de l'application
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/posts_auto

# Connexion d'administration utilisée par les tests pour créer des bases jetables
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres

# Adresse publique de l'application (liens envoyés par e-mail)
APP_URL=http://localhost:3000

# Dossier des images en développement (en production : stockage objet S3 dans l'UE)
MEDIA_ROOT=.media

# Application LinkedIn A de SimplX (section 8.2). Adresse de retour à déclarer chez LinkedIn :
#   <APP_URL>/comptes/connecter/retour
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# « fake » en développement : connexion et publication simulées, rien ne part chez LinkedIn.
LINKEDIN_MODE=fake
# Version AAAAMM de l'API LinkedIn (tâches de fond)
LINKEDIN_API_VERSION=202610

# E-mails transactionnels (Brevo). Sans ces valeurs, les e-mails s'affichent dans la console.
# Le domaine de MAIL_FROM doit être authentifié chez Brevo (SPF, DKIM, DMARC).
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Posts LinkedIn

# Idées et demandes par e-mail (IDE-07, Brevo Inbound Parsing). Sans ces trois valeurs, la
# fonction est masquée. Le domaine de réception doit différer du domaine d'envoi.
# Générer chaque secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_WEBHOOK_SECRET=

# Chiffrement des jetons LinkedIn (SEC-02) : « id:clé_base64 », séparés par des virgules.
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_ID=

# Rédaction par l'IA (décision 0005). « fake » : textes de démonstration, aucun appel.
# « anthropic » : API Anthropic, avec la clé de l'éditeur (contrat sans réutilisation des données).
AI_MODE=fake
ANTHROPIC_API_KEY=
# Modèle utilisé (ADM-04) ; par défaut claude-opus-5-5.
AI_MODEL=
# Taux de conversion du coût IA (facturé en dollars) en euros, à tenir à jour (GEN-11).
AI_USD_TO_EUR=0.86

# Adresse de l'éditeur qui reçoit les signalements de contenu (GEN-12).
SUPPORT_EMAIL=

# Site vitrine (SIT-02) : destinataire des demandes de démonstration, et CRM facultatif
# (POST JSON signé par l'en-tête X-Demo-Secret).
SALES_EMAIL=
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

# Connexion avec Google ou Microsoft (ONB-01) : clients OAuth de l'éditeur ; « SSO_MODE=fake »
# pour une connexion simulée en développement. Sans configuration, seuls les liens par e-mail.
SSO_MODE=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Paiement (FAC-01, décision 0007). « fake » : paiement simulé, rien n'est prélevé
# (développement, démonstration) ; sinon Stripe avec STRIPE_SECRET_KEY. Webhook :
# /api/stripe/webhook, signé avec STRIPE_WEBHOOK_SECRET.
BILLING_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Connecteur Canva (VIS-07) : intégration Canva Connect de l'éditeur ; « CANVA_MODE=fake »
# pour un Canva simulé en développement.
CANVA_MODE=fake
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Images générées pour les visuels (VIS-05, décision 0006).
# « fake » : images simulées (développement) ; « higgsfield » : API Higgsfield, avec la clé
# de l'éditeur ; vide : aucune image générée (photo de la médiathèque ou visuel texte).
IMAGE_MODE=fake
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Modèle Higgsfield ; par défaut higgsfield-ai/soul/standard.
HIGGSFIELD_MODEL=
# Coût d'une image en dollars, pour le suivi des coûts (GEN-11).
HIGGSFIELD_COST_USD=
